# Copy to .env (never commit .env). Every variable uses the PFA_ prefix.
PFA_APP_NAME=Personal Finance Agent
PFA_APP_ENV=development
PFA_DEBUG=true
PFA_API_V1_PREFIX=/api/v1
PFA_LOG_LEVEL=INFO

# Security & JWT
PFA_JWT_SECRET_KEY=float-personal-finance-agent-secret-key-min32chars
PFA_JWT_ALGORITHM=HS256
PFA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
PFA_DATABASE_URL=postgresql+asyncpg://float:your_password@localhost:5432/float
