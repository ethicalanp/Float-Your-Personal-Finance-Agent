# Copy to .env (never commit .env). Every variable uses the PFA_ prefix.
PFA_APP_NAME=Personal Finance Agent
PFA_APP_ENV=development
PFA_DEBUG=true
PFA_API_V1_PREFIX=/api/v1
PFA_LOG_LEVEL=INFO

# Security & JWT (Must be randomized 32+ chars in production)
PFA_JWT_SECRET_KEY=generate_a_cryptographically_secure_random_32_character_string
PFA_JWT_ALGORITHM=HS256
PFA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMS Provider & MSG91 Configuration
PFA_SMS_PROVIDER=fake
PFA_MSG91_AUTH_KEY=
PFA_MSG91_TEMPLATE_ID=
PFA_MSG91_SENDER_ID=
PFA_SMS_DAILY_CAP=1000

# Optional, versioned LightGBM artifact directory. Train an artifact before enabling assessments.
PFA_BORROW_MODEL_PATH=artifacts/borrow/current

# PostgreSQL (Standardized on Psycopg 3: postgresql+psycopg://)
PFA_DATABASE_URL=postgresql+psycopg://float:your_password@localhost:5432/float
